views:
  - type: table
    name: 글 후보와 발행
    filters:
      and:
        - file.inFolder("10-concepts")
        - post_format != "none"
    order:
      - file.name
      - post_format
      - captured_at
      - published_at
      - status
  - type: table
    name: 글감 창고
    filters:
      and:
        - file.inFolder("30-ideas")
    order:
      - file.name
      - file.mtime
