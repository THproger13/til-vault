filters:
  and:
    - file.inFolder("10-concepts")
formulas:
  남은일수: 'if(next_review, (date(next_review) - today()).days, "")'
properties:
  status:
    displayName: 상태
  review_count:
    displayName: 복습 횟수
  accuracy:
    displayName: 정답률(%)
  last_reviewed:
    displayName: 마지막 복습
  next_review:
    displayName: 다음 복습
  formula.남은일수:
    displayName: D-
  part_of:
    displayName: 상위 개념
  prerequisite:
    displayName: 선행 개념
  compared_with:
    displayName: 비교 개념
  blog_requested_at:
    displayName: 초안 요청일
  drafted_at:
    displayName: 초안 생성일
  draft_path:
    displayName: 초안 파일
views:
  - type: table
    name: 지금 노트와 연결
    filters:
      or:
        - file.hasLink(this.file)
        - this.file.hasLink(file)
    order:
      - file.name
      - status
      - review_count
      - accuracy
      - next_review
  - type: table
    name: 상태별 전체
    filters:
      and:
        - status != "unexplored"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - review_count
      - accuracy
      - next_review
      - part_of
      - prerequisite
  - type: table
    name: 오늘 복습
    filters:
      and:
        - date(next_review) <= today()
    order:
      - file.name
      - status
      - next_review
      - formula.남은일수
      - review_count
      - accuracy
  - type: table
    name: 초안 대상·진행
    filters:
      or:
        - status == "blog"
        - status == "drafted"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - blog_requested_at
      - drafted_at
      - draft_path
      - accuracy
  - type: table
    name: 개념 지도 (상위 개념별)
    groupBy:
      property: part_of
      direction: ASC
    order:
      - file.name
      - status
      - prerequisite
      - compared_with
      - review_count
